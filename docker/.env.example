# Oben-DTA Environment Configuration
# Copy this file to .env and fill in secure values before first run.
# NEVER commit .env to version control.

# PostgreSQL
POSTGRES_USER=dta
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=dta_db

# Backend Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=dta
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=dta_db

# JWT
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# App
PORT=3004
NODE_ENV=development
FRONTEND_URL=http://frontend:3000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Licenciamiento — firma Ed25519 de licencias comerciales.
# Generar UNA vez con: npm run license:generate-keys (dentro de backend/)
# La clave privada NUNCA debe salir del entorno del emisor (Paradixe).
LICENSE_SIGNING_PRIVATE_KEY=REPLACE_WITH_GENERATED_PRIVATE_KEY_BASE64
LICENSE_SIGNING_PUBLIC_KEY=REPLACE_WITH_GENERATED_PUBLIC_KEY_BASE64
LICENSE_SIGNING_KEY_ID=paradixe-YYYY-MM-DD
